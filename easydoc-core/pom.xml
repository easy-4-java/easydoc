<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>3.0.x.20260630-SNAPSHOT</version>
	</parent>
	<artifactId>easydoc-core</artifactId>
	
	<description>Building doc documents based on doc/docx file using docx4j</description>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>
	
	<dependencies>
	
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
    	
    	<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>
		
		<!-- ###################### Docx4j ###################### -->
		
		<!-- Docx4j Core -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-core</artifactId>
		</dependency>
		
		<!-- Docx4j JAXB Internal
	    <dependency>
	        <groupId>org.docx4j</groupId>
	        <artifactId>docx4j-JAXB-Internal</artifactId>
	    </dependency> -->
	        
	    <!-- Docx4j JAXB ReferenceImpl (replaces MOXy).

	     docx4j-JAXB-MOXy 11.5.14 cannot be used on JDK 21 + jakarta.xml.bind-api 4.x:
	     MOXy 2.7.6 is compiled against javax.xml.bind (JAXB 2.x) so its static
	     initializers throw NoClassDefFoundError on the jakarta namespace, and its
	     META-INF/services/jakarta.xml.bind.JAXBContext file is the legacy JAXB 2.x
	     SPI name that jakarta.xml.bind-api 4.x does not consult (it looks for
	     jakarta.xml.bind.JAXBContextFactory). docx4j's static initializer therefore
	     silently selects the Glassfish Reference Implementation instead, but then
	     the namespace-prefix-mapper bridge fails because
	     org/docx4j/jaxb/ri/NamespacePrefixMapper is not on the classpath. Net
	     effect: WordprocessingMLPackage.load(File) and any process(...) path that
	     reaches it NPEs at runtime. docx4j-JAXB-ReferenceImpl 11.5.14 works
	     correctly with jakarta.xml.bind-api 4.0 and the org.glassfish.jaxb:jaxb-runtime
	     4.0.x already declared in the root pom dependencyManagement. -->

	    <dependency>
	        <groupId>org.docx4j</groupId>
	        <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
	    </dependency>

	    <!-- docx4j-openxml-objects 11.5.14：javax 时代的 OOXML 模型构件。
	         与 docx4j-generated-objects 17.0.3（jakarta 时代）同 FQN，两者
	         同时进类路径存在撞类风险——保留此处声明以便实证，结论见提交说明 -->
	    <dependency>
	        <groupId>org.docx4j</groupId>
	        <artifactId>docx4j-openxml-objects</artifactId>
	    </dependency>
	    
		<!-- https://mvnrepository.com/artifact/ognl/ognl -->
		<dependency>
			<groupId>ognl</groupId>
			<artifactId>ognl</artifactId>
		</dependency>

		<!-- SLF4J binding（test scope）：否则测试类路径上没有任何 provider，
		     LOG.warn 会落到 NOP logger，WordprocessingMLTemplateVariantsTest
		     无法断言 JDK 21 透明降级的 WARN 日志（slf4j-simple 默认输出到
		     System.err，版本由根 pom dependencyManagement 管理） -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>


		<!-- JAXB 4.x runtime provider. docx4j 11.5.14 statically initializes
		     org.docx4j.jaxb.Context to look up jakarta.xml.bind.JAXBContext
		     via ServiceLoader; the default fallback class
		     (org.glassfish.jaxb.runtime.v2.ContextFactory) is not on the
		     classpath without this jar, so jcContentTypes ends up null and
		     every WordprocessingMLPackage.load() throws "Bad [Content_Types].xml".
		     Adding jaxb-runtime provides the missing provider so the docx4j
		     static initializer completes. -->
		<dependency>
		    <groupId>org.glassfish.jaxb</groupId>
		    <artifactId>jaxb-runtime</artifactId>
		</dependency>

		<!-- docx4j FOP 导出（PDF/HTML 渲染）；test scope 供 WordprocessingMLPackageWriter
		     writeToPDF/writeToHtml 路径的测试使用 -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-export-fo</artifactId>
		    <scope>test</scope>
		</dependency>

		<!-- docx4j FOP 字体子模块（11.5.3 引入）；test scope 让 PDF/HTML 渲染能解析
		     Symbol / Common Cross-core / Cross-extra 字体集，无需系统级字体 -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-export-fo-fonts-symbol</artifactId>
		    <scope>test</scope>
		</dependency>
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-export-fo-fonts-croscore</artifactId>
		    <scope>test</scope>
		</dependency>
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-export-fo-fonts-crosextra</artifactId>
		    <scope>test</scope>
		</dependency>

	</dependencies>
	
</project>