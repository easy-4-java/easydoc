<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>2.0.x.20260630-SNAPSHOT</version>
	</parent>
	<artifactId>easydoc-core</artifactId>
	
	<description>Building doc documents based on doc/docx file using docx4j</description>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>
	
	<dependencies>
	
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
    	
    	<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>
		
		<!-- ###################### Docx4j ###################### -->

		<!-- Docx4j Core -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-core</artifactId>
		</dependency>

	    <!-- Docx4j JAXB ReferenceImpl (replaces MOXy; compatible with jakarta.xml.bind-api 4.x) -->
	    <dependency>
	        <groupId>org.docx4j</groupId>
	        <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
	    </dependency>

	    <!-- JAXB 4.x runtime provider (docx4j 11.5.14 needs this for ServiceLoader-based JAXBContext init) -->
	    <dependency>
	        <groupId>org.glassfish.jaxb</groupId>
	        <artifactId>jaxb-runtime</artifactId>
	    </dependency>
	    
	    <!-- https://mvnrepository.com/artifact/ognl/ognl -->
		<dependency>
		    <groupId>ognl</groupId>
		    <artifactId>ognl</artifactId>
		</dependency>

	</dependencies>
	
</project>