<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>easydoc-core</artifactId>

	<description>Building doc documents based on doc/docx file using docx4j</description>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>

	<dependencies>

		<!-- ======== Servlet ======== -->

		<!-- javax.servlet-api：Servlet 容器 API，编译期依赖（运行时由容器提供） -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- ======== Commons 工具库 ======== -->

		<!-- commons-lang3：字符串、对象、数组等常用工具方法 -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>

		<!-- commons-io：文件/流操作工具类 -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>

		<!-- ======== Docx4j ======== -->

		<!-- docx4j-core：Open XML（docx/pptx/xlsx）解析与生成核心库 -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-core</artifactId>
		</dependency>

	    <!-- docx4j-JAXB-ReferenceImpl：docx4j 的 JAXB ReferenceImpl 实现，兼容 jakarta.xml.bind-api 4.x -->
	    <dependency>
	        <groupId>org.docx4j</groupId>
	        <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
	    </dependency>

	    <!-- jaxb-runtime（GlassFish）：Jakarta JAXB 4 运行时，docx4j 11.5.14 通过 ServiceLoader 加载 JAXBContext -->
	    <dependency>
	        <groupId>org.glassfish.jaxb</groupId>
	        <artifactId>jaxb-runtime</artifactId>
	    </dependency>

	    <!-- ======== 表达式引擎 ======== -->

	    <!-- https://mvnrepository.com/artifact/ognl/ognl -->
	    <!-- OGNL：表达式语言引擎，用于模板中的动态值计算 -->
		<dependency>
		    <groupId>ognl</groupId>
		    <artifactId>ognl</artifactId>
		</dependency>

	</dependencies>

</project>