<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>${revision}</version>
	</parent>
	
	<artifactId>easydoc-xhtml</artifactId>
	<description>Building doc documents based on xhtml templates using docx4j</description>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>
	
	<dependencies>
	
		<!-- ======== Servlet ======== -->
		<!-- Servlet API：Web 容器接口，provided scope 由运行时容器提供 -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
    	
		<!-- ======== Easydoc 核心 ======== -->
		<!-- easydoc-core：本项目核心模块，提供文档生成基础能力 -->
    	<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>easydoc-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		
		<!-- ###################### HTML、CSS 解析工具包 ###################### -->
		
		<!-- Jsoup：HTML 解析与操作库，用于 XHTML 内容预处理 -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>
		
		<!-- ======== Docx4j XHTML 导入 ======== -->
 		<!-- xhtmlrenderer：基于 Flying Saucer 的 XHTML/CSS 渲染引擎 -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>xhtmlrenderer</artifactId>
		</dependency>
		<!-- docx4j-ImportXHTML：将 XHTML 内容转换为 Word 文档段落 -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-ImportXHTML</artifactId>
		</dependency>

		<!-- ======== Markdown 解析 ======== -->
		<!-- flexmark：Markdown → HTML（GFM 表格/代码块扩展） -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-all</artifactId>
		</dependency>
		<!-- flexmark HTML→Markdown 转换器（FlexmarkHtmlConverter，AST 驱动，
		     替代 MarkdownConverter.htmlToMarkdown 中的正则映射，解决 F1 系列
		     标题属性/嵌套列表/有序编号/表格分隔行/内联代码/锚点失真问题。 -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-html2md-converter</artifactId>
		    <version>${flexmark.version}</version>
		</dependency>

		<!-- ======== 日志桥接 ======== -->
		<!-- jcl-over-slf4j：ImportXHTML 转换路径中 pdfbox 依赖 commons-logging 接口，
		     docx4j-ImportXHTML 已排除 commons-logging 并约定由本桥接提供 -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jcl-over-slf4j</artifactId>
		</dependency>
		<!-- ======== Test ======== -->
		<!-- EclipseLink ORM：测试中用于 MOXy JAXB 运行时验证 -->
		<dependency>
			<groupId>org.eclipse.persistence</groupId>
			<artifactId>eclipselink</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>
	
</project>
