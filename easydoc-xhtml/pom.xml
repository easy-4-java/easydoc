<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
	
	<modelVersion>4.1.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>${revision}</version></parent>
	
	<artifactId>easydoc-xhtml</artifactId>
	<description>Building doc documents based on xhtml templates using docx4j</description>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>
	
	<dependencies>

		<!-- ======== 内部模块 ======== -->
		<!-- easydoc 核心模块（docx4j 封装、通用工具类） -->
    	<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>easydoc-core</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- ======== HTML / CSS 解析 ======== -->

		<!-- Jsoup（HTML 解析与 DOM 操作，XHTML 模板预处理） -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>

		<!-- ======== Docx4j ImportXHTML ======== -->

		<!-- Docx4j ImportXHTML（XHTML 转 docx 的核心引擎） -->
		<dependency>
		    <groupId>org.docx4j</groupId>
		    <artifactId>docx4j-ImportXHTML-core</artifactId>
		</dependency>

		<!-- flexmark 最小依赖集（#24）：仅取 MarkdownConverter 实际使用的四个构件，
		     替换原 flexmark-all 聚合件（其 POM 声明 30+ 全家桶传递依赖）。
		     注意：0.64.x 系列扩展构件名为 flexmark-ext-*（任务书中的 flexmark-tables
		     等是 0.4x 旧命名，Central 上无此版本）；版本沿用根 pom 的 flexmark.version
		     属性（根 dependencyManagement 未纳管分构件，故此处显式声明）。 -->
		<!-- flexmark 核心（Parser/HtmlRenderer/util 基础设施，传递引入 flexmark-util-* 系列） -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark</artifactId>
		    <version>${flexmark.version}</version>
		</dependency>
		<!-- flexmark GFM 表格扩展（pipe tables；TablesExtension 位于 ext.tables 包） -->
		<dependency>
			<groupId>com.vladsch.flexmark</groupId>
			<artifactId>flexmark-ext-tables</artifactId>
			<version>${flexmark.version}</version>
		</dependency>
		<!-- flexmark GFM 删除线扩展（~~strikethrough~~） -->
		<dependency>
			<groupId>com.vladsch.flexmark</groupId>
			<artifactId>flexmark-ext-gfm-strikethrough</artifactId>
			<version>${flexmark.version}</version>
		</dependency>
		<!-- flexmark 自动链接扩展（裸 URL/邮箱识别，传递引入 org.nibor.autolink） -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-ext-autolink</artifactId>
		    <version>${flexmark.version}</version>
		</dependency>
		<!-- flexmark HTML→Markdown 转换器（FlexmarkHtmlConverter，AST 驱动，
		     替代 MarkdownConverter.htmlToMarkdown 中的正则映射，解决 F1 系列
		     标题属性/嵌套列表/有序编号/表格分隔行/内联代码/锚点失真问题。
		     传递依赖含 jsoup（与现有 jsoup 1.23.1 无冲突，见 Task 3 验证）。 -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-html2md-converter</artifactId>
		    <version>${flexmark.version}</version>
		</dependency>

		<!-- ======== Test ======== -->
		<!-- EclipseLink（test scope，MOXy JAXB 实现的运行时依赖，XHTML 转换测试用） -->
		<dependency>
			<groupId>org.eclipse.persistence</groupId>
			<artifactId>eclipselink</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>
	
</project>