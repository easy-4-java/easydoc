<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
	
	<modelVersion>4.1.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<!-- Maven 4 (POM 4.1.0)：parent version 由 reactor 自动解析，无需显式版本 -->
	</parent>
	
	<artifactId>easydoc-jetbrick</artifactId>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>

	<dependencies>
		<!-- easydoc-xhtml 模块（XHTML 模板处理核心） -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>easydoc-xhtml</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.github.subchen/jetbrick-template -->
		<!-- Jetbrick Template 模板引擎（类 JSP 语法的高性能模板引擎）；
		     排除传递的 antlr4-runtime，使用模块内显式声明的 4.7.1 版本 -->
		<dependency>
			<groupId>com.github.subchen</groupId>
			<artifactId>jetbrick-template</artifactId>
			<exclusions>
				<!-- jetbrick 2.1.10 编译自 antlr4 4.7.1；根 pom 为 beetl 强制 4.9.3，
				     这里排除并用模块内版本覆盖，避免 antlr runtime 版本冲突 -->
				<exclusion>
					<groupId>org.antlr</groupId>
					<artifactId>antlr4-runtime</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- ANTLR4 运行时 4.7.1（与 jetbrick-template 2.1.10 编译版本匹配） -->
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4-runtime</artifactId>
			<version>4.7.1</version>
		</dependency>
	</dependencies>
	
</project>