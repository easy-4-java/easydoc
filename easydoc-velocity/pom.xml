<project xmlns="http://maven.apache.org/POM/4.1.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">

	<modelVersion>4.1.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>${revision}</version></parent>

	<artifactId>easydoc-velocity</artifactId>
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>

	<dependencies>
		<!-- easydoc-xhtml 模块（XHTML 模板处理核心） -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>easydoc-xhtml</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- ======== Velocity 模板引擎 ======== -->
		<!-- https://mvnrepository.com/artifact/org.apache.velocity/velocity-engine-core -->
		<!-- Velocity 引擎核心（VTL 模板解析与渲染） -->
		<dependency>
			<groupId>org.apache.velocity</groupId>
			<artifactId>velocity-engine-core</artifactId>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.apache.velocity/tools -->
		<!-- Velocity Tools Generic（3.x 通用工具集，含 DateTool；不再依赖 Struts，无需排除） -->
		<dependency>
			<groupId>org.apache.velocity.tools</groupId>
			<artifactId>velocity-tools-generic</artifactId>
		</dependency>

	</dependencies>

</project>