<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.easy4j</groupId>
		<artifactId>easydoc</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>easydoc-velocity</artifactId>
	<!-- Apache Velocity 模板引擎集成模块：将 Velocity 作为模板引擎生成 Word 文档 -->
	<name>${project.groupId}:${project.artifactId}</name>
	<packaging>jar</packaging>

	<dependencies>
		<!-- ======== Easydoc 核心 ======== -->
		<!-- easydoc-xhtml：XHTML 模板文档生成模块 -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>easydoc-xhtml</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- ======== 模板引擎 ======== -->
		<!-- Source: https://mvnrepository.com/artifact/org.apache.velocity/velocity-engine-core -->
		<!-- Apache Velocity 引擎核心：经典模板引擎 -->
		<dependency>
			<groupId>org.apache.velocity</groupId>
			<artifactId>velocity-engine-core</artifactId>
		</dependency>
		<!-- Source: https://mvnrepository.com/artifact/org.apache.velocity/velocity-engine-scripting -->
		<!-- Velocity JSR-223 脚本引擎适配 -->
		<dependency>
			<groupId>org.apache.velocity</groupId>
			<artifactId>velocity-engine-scripting</artifactId>
		</dependency>
		<!-- Source: https://mvnrepository.com/artifact/org.apache.velocity.tools/velocity-tools-generic -->
		<!-- Velocity 工具集（3.x 起拆分为 velocity-tools-generic）：提供日期、数字、字符串等常用工具 -->
		<!-- 3.1 已修复 CVE-2020-13936；generic 模块不再依赖 Struts 1.x，无需 struts 排除 -->
		<dependency>
			<groupId>org.apache.velocity.tools</groupId>
			<artifactId>velocity-tools-generic</artifactId>
		</dependency>

	</dependencies>

</project>
